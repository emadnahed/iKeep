# iKeep Production Environment Configuration
# Copy this file to .env on your VPS server

# ===========================================
# REQUIRED - Must be set before deployment
# ===========================================

# JWT Secret for authentication tokens (REQUIRED)
# Generate: openssl rand -base64 32
# IMPORTANT: Use a unique, strong secret in production
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_STRING

# CORS allowed origin - Your Vercel frontend URL (REQUIRED)
# Example: https://ikeep.vercel.app or https://your-custom-domain.com
# Multiple origins: https://ikeep.vercel.app,https://www.ikeep.com
CORS_ORIGIN=https://your-vercel-app.vercel.app

# ===========================================
# DOCKER INTERNAL (Usually no changes needed)
# ===========================================

# Node environment
NODE_ENV=production

# Server port (internal to Docker network)
PORT=5000

# MongoDB connection (internal Docker service name)
# Change only if using external MongoDB (e.g., MongoDB Atlas)
# Atlas example: mongodb+srv://user:pass@cluster.mongodb.net/ikeeper
MONGO_URI=mongodb://mongo:27017/ikeeper

# Redis connection (internal Docker service name)
# Change only if using external Redis (e.g., Redis Cloud)
# Redis Cloud example: redis://user:pass@host:port
REDIS_URL=redis://redis:6379

# ===========================================
# DEPLOYMENT COMMANDS
# ===========================================
#
# 1. Copy this file to .env:
#    cp .env.production.example .env
#
# 2. Generate and set JWT_SECRET:
#    openssl rand -base64 32
#
# 3. Set your Vercel frontend URL in CORS_ORIGIN
#
# 4. Start the services:
#    docker-compose -f docker-compose.prod.yml up -d
#
# 5. Scale backend instances:
#    docker-compose -f docker-compose.prod.yml up -d --scale backend=5
#
# 6. View logs:
#    docker-compose -f docker-compose.prod.yml logs -f backend
#
# 7. Check health:
#    curl http://localhost/api/health/detailed
#
# ===========================================
# VERCEL FRONTEND SETUP
# ===========================================
#
# In Vercel dashboard, set this environment variable:
#   REACT_APP_API_URL = https://your-vps-domain.com
#
# Or if using the vercel CLI:
#   vercel env add REACT_APP_API_URL production
#
