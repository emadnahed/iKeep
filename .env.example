# iKeep Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# REQUIRED - Application will not start without these
# ===========================================

# JWT Secret for authentication tokens
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=your-secure-secret-key-here

# ===========================================
# OPTIONAL - Defaults provided for development
# ===========================================

# Server port (default: 5000)
PORT=5000

# Node environment (development, test, production)
NODE_ENV=development

# MongoDB connection string
# Development: mongodb://localhost:27017/ikeeper
# Docker: mongodb://mongo:27017/ikeeper
MONGO_URI=mongodb://localhost:27017/ikeeper

# Redis connection string (for distributed rate limiting)
# Development: redis://localhost:6379
# Docker: redis://redis:6379
REDIS_URL=redis://localhost:6379

# CORS allowed origins (comma-separated for multiple)
# Development: http://localhost:3000,http://localhost:8080
# Production: https://your-vercel-app.vercel.app
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# ===========================================
# FRONTEND (React)
# ===========================================

# API URL for the React frontend
# Development: http://localhost:5000
# Docker: http://localhost:8080
# Production (Vercel): Set in Vercel dashboard
REACT_APP_API_URL=http://localhost:5000
